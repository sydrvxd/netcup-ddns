# Multi-domain config: domain:hosts:credential_prefix separated by ;
# All domains use the same Netcup account, so no prefix needed:
DOMAINS=sydrv.de:*,@;fm-p.de:*,@

# Netcup credentials (global — used for all domains)
NETCUP_CUSTOMER_ID=your_customer_id
NETCUP_API_KEY=your_api_key
NETCUP_API_PASSWORD=your_api_password

# Intervals
DDNS_INTERVAL=300
CLEANUP_ENABLED=true
CLEANUP_INTERVAL=86400
TZ=Europe/Berlin
